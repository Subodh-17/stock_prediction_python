# Copy this file to .env and fill in the keys you have.
# Any provider left blank is automatically skipped by the ensemble.

TICKER=AAPL
PERIOD=2y
INTERVAL=1d
LOOKBACK_WINDOW=30
# Changing TRAIN_TEST_SPLIT invalidates any saved LSTM checkpoint trained
# under a different value -- the checkpoint is refused rather than reused,
# because its "test" window would no longer be fully out of sample.
TRAIN_TEST_SPLIT=0.8

# What the LSTM is trained to predict: "return" (default) or "price".
LSTM_PREDICTION_TARGET=return
# Seed for Python/NumPy/TensorFlow. Best-effort determinism, not a guarantee.
RANDOM_SEED=42

# --- Data source ---
# auto = yfinance first, then Upstox/Groww fallback for Indian stocks if configured
DATA_SOURCE=auto

# Upstox (Indian NSE/BSE) -- from https://account.upstox.com/developer/apps
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=

# Groww (Indian NSE/BSE) -- Option A: daily token from https://groww.in/user/profile/trading-apis
GROWW_ACCESS_TOKEN=
# Groww -- Option B: long-lived key+secret from https://groww.in/trade-api/api-keys
GROWW_API_KEY=
GROWW_API_SECRET=

# --- Trading (buy/sell) ---
# SAFE BY DEFAULT: leave this as "false" to keep every trade.py run in
# simulated PAPER mode. Only change to "true" once you understand the risks
# (see README.md's "Trading" section) -- this is a deliberate, separate
# opt-in from any CLI flag, on purpose.
ENABLE_LIVE_TRADING=false

DEFAULT_BROKER=paper
BUY_THRESHOLD_PCT=0.5
SELL_THRESHOLD_PCT=-0.5
MAX_POSITION_PCT=0.10
MAX_ORDER_VALUE=10000
MAX_TRADES_PER_DAY=5
PAPER_STARTING_CASH=100000

LSTM_UNITS=64
LSTM_EPOCHS=25
LSTM_BATCH_SIZE=16

# --- Ensemble weighting (must be non-negative, should sum to something sensible) ---
LR_WEIGHT=0.5
LSTM_WEIGHT=0.5
# V17: 0 = LLMs are NOT part of the numerical forecast (no evidence they add out-of-sample value).
# Raise only if you have evaluated it chronologically against the same baseline without the LLM.
LLM_PANEL_WEIGHT=0.0
# "fixed" (default) uses the three weights above as-is. "dynamic" derives the
# LR/LSTM split from walk-forward validation RMSE instead; the LLM panel's
# weight is never raised dynamically.
ENSEMBLE_WEIGHTING_MODE=fixed
# Floor on each of LR/LSTM under dynamic weighting, so a small validation
# sample can never drive one model to ~0% and the other to ~100%.
ENSEMBLE_MIN_WEIGHT_FLOOR=0.15
# Out-of-sample folds required per model before dynamic weights are trusted.
DYNAMIC_WEIGHTS_MIN_FOLDS=3

# --- Backtesting (simulation only -- never a forecast of future returns) ---
BACKTEST_INITIAL_CAPITAL=100000
BACKTEST_TRANSACTION_COST_PCT=0.1
BACKTEST_RISK_FREE_RATE_ANNUAL_PCT=0

# --- Optional extra risk controls (0 = disabled, which is the default) ---
STOP_LOSS_PCT=0
TAKE_PROFIT_PCT=0
MAX_PORTFOLIO_EXPOSURE_PCT=0
DAILY_LOSS_LIMIT_PCT=0

# --- Web app ---
# Signs the session cookie. Leave unset and a random one is generated per
# process, which logs everyone out on every restart and breaks entirely if
# you ever run more than one worker. Set a long random value for real use.
# Leave unset to get a random per-process key (sessions reset on restart). Do NOT leave it as an empty
# assignment on older builds -- that used to break every page. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# WEBAPP_SECRET_KEY=
# REQUIRED for live trading through the web UI, on top of
# ENABLE_LIVE_TRADING=true below. With this unset (the default) the
# live-trading routes refuse outright -- being able to reach the page is
# never enough to place a real order. Must be at least 32 characters.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
WEBAPP_LIVE_TRADING_TOKEN=
WEBAPP_PORT=5000
# Leave false. Werkzeug's debugger is remote code execution if reachable.
WEBAPP_DEBUG=false

# --- LLM API keys ---
# How the Gemini REST client sends its key: "header" (default, keeps it out
# of the request URL) or "query" (legacy ?key=... fallback).
GEMINI_AUTH_MODE=header

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=

# --- Optional tuning knobs (all have sensible defaults; safe to leave unset) ---
# Model names -- update as providers release new versions.
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_MODEL=gpt-4o
# gemini-2.0-flash was shut down 2026-06-01 (that was the old 404). Model availability is per account:
# press 'Test connection' in AI Research to list the models your key can use.
GOOGLE_MODEL=gemini-3.5-flash-lite
XAI_MODEL=grok-4
DEEPSEEK_MODEL=deepseek-chat
# Panel-wide ceiling (seconds) on top of each provider's own ~30s timeout.
LLM_PANEL_TIMEOUT_SECONDS=45

# yfinance resilience: transient failures (429/timeouts/resets) are retried
# with exponential backoff. A genuinely empty result is never retried.
DATA_FETCH_MAX_RETRIES=3
DATA_FETCH_RETRY_BACKOFF_SECONDS=1.5
DATA_FETCH_TIMEOUT_SECONDS=15

# Output / state locations.
OUTPUT_DIR=outputs
CHECKPOINT_DIR=checkpoints
# A loaded checkpoint older than this logs a "may be stale" note.
CHECKPOINT_STALE_WARNING_DAYS=7
PAPER_PORTFOLIO_PATH=.paper_portfolio.json
TRADE_LOG_PATH=outputs/trade_log.csv

# Minimum length enforced on WEBAPP_LIVE_TRADING_TOKEN. Lower it only if you
# genuinely understand why a short shared secret is weak protection.
WEBAPP_LIVE_TRADING_TOKEN_MIN_LENGTH=32

# --- Logging (server-side diagnostics; CLI report output is unaffected) ---
# DEBUG | INFO | WARNING | ERROR. Every record is passed through the shared
# redactor, so a secret cannot be written to a log even by accident.
LOG_LEVEL=INFO

# --- Hardening ---
# Max accepted request body for the web app. This app has no file-upload
# routes, so this is the entirety of its upload surface. Oversized requests
# get a clean 413.
WEBAPP_MAX_CONTENT_LENGTH_BYTES=262144
# Refuse an identical LIVE order (same ticker/side/quantity) within this many
# seconds of one that already executed, to stop accidental double-submits.
# 0 disables. Paper orders are never blocked by this.
DUPLICATE_ORDER_WINDOW_SECONDS=60


# ---------------------------------------------------------------------------
# V17: additional free-tier-capable AI providers (optional; ids are account-specific -- no defaults)
# ---------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
AI_REQUEST_TIMEOUT_SECONDS=25
AI_GLOBAL_BUDGET_SECONDS=40
AI_FAILURE_COOLDOWN_SECONDS=120
AI_RESEARCH_CACHE_SECONDS=1800

# ---------------------------------------------------------------------------
# V17: market-data freshness and caching
# ---------------------------------------------------------------------------
# "Live" is shown only for a provider entitled to real-time data AND a source timestamp this fresh.
LIVE_MAX_AGE_SECONDS=20
QUOTE_TTL_SECONDS=15
HISTORY_TTL_SECONDS=900
# A failed history request is not retried for this many seconds (stops a failing provider being hit on every refresh)
HISTORY_FAILURE_TTL_SECONDS=30
DELAYED_STALE_AFTER_SECONDS=1800
PROVIDER_MAX_CONCURRENCY=4
FORECAST_CACHE_TTL_SECONDS=21600

# ---------------------------------------------------------------------------
# V17: news (empty = no news panel; headlines are never generated)
# Comma-separated "Name|URL"; {symbol} is replaced by the ticker. Use feeds whose terms allow your use.
# ---------------------------------------------------------------------------
NEWS_FEEDS=
NEWS_TIMEOUT_SECONDS=8

# Web app: requests/minute/IP for expensive JSON endpoints (forecast, backtest, AI)
WEBAPP_EXPENSIVE_RPM=12

# ---------------------------------------------------------------------------
# V18: background jobs
# ---------------------------------------------------------------------------
# Classic /predict and /api/predict wait at most this long for the job; otherwise they return 202 + a job id at once.
LEGACY_PREDICT_WAIT_SECONDS=2.0
# A running job older than this is reported as "timeout" (the worker thread cannot be killed mid-fit).
JOB_TIMEOUT_SECONDS=900

# V19: an LLM may add to the NUMERICAL forecast only with this exact acknowledgement that you hold documented, leakage-free,
# chronological out-of-sample evidence. Without it LLM_PANEL_WEIGHT is ignored (forced to 0). Leave unset.
# LLM_PANEL_WEIGHT_EVIDENCE_ACK=I_HAVE_OUT_OF_SAMPLE_EVIDENCE

# Drop a daily bar whose trading session is still in progress (set "false" only if you understand the look-ahead risk).
DROP_OPEN_SESSION_BAR=true

# Warm TensorFlow/LSTM tracing in the background at server start so the first forecast is not slower (set "false" to skip).
WARMUP_ON_START=true
